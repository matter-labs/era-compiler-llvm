; CHECK-NEXT:    [[Z:%.*]] = zext i1 [[LT7]] to i256
; CHECK-NEXT:    [[RES:%.*]] = add nuw nsw i256 [[SEL]], [[Z]]
; CHECK-NEXT:    ret i256 [[RES]]
;
entry:
  %y_m = and i256 %y, 15
  %yb = or disjoint i256 %y_m, 16
  %guarded = call range(i256 0, 10) i256 @llvm.umin.i256(i256 %x, i256 %yb)
  %sel = select i1 %guard, i256 %guarded, i256 0
  %c2 = call i256 @llvm.umin.i256(i256 %yb, i256 %x)
  %k = and i256 %k0, 3
  %ky = add i256 %k, %yb
  %diff = sub i256 %ky, %c2
  %lt7 = icmp ult i256 %diff, 7
  %z = zext i1 %lt7 to i256
  %res = add i256 %sel, %z
  ret i256 %res
}
