target triple = "evm-unknown-unknown"

declare i256 @llvm.umin.i256(i256, i256)

define i256 @earlycse_commutative_intrinsic_attrs(i256 %x, i256 %y, i256 %k0, i1 %guard) {
; CHECK-LABEL: define range(i256 0, 33) i256 @earlycse_commutative_intrinsic_attrs(
; CHECK-SAME: i256 [[X:%.*]], i256 [[Y:%.*]], i256 [[K0:%.*]], i1 [[GUARD:%.*]]) local_unnamed_addr #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[Y_M:%.*]] = and i256 [[Y]], 15
; CHECK-NEXT:    [[YB:%.*]] = or disjoint i256 [[Y_M]], 16
; CHECK-NEXT:    [[GUARDED:%.*]] = tail call range(i256 0, 10) i256 @llvm.umin.i256(i256 [[X]], i256 [[YB]])
; CHECK-NEXT:    [[SEL:%.*]] = select i1 [[GUARD]], i256 [[GUARDED]], i256 0
; CHECK-NEXT:    [[K:%.*]] = and i256 [[K0]], 3
; CHECK-NEXT:    [[TMP0:%.*]] = tail call i256 @llvm.usub.sat.i256(i256 [[YB]], i256 [[X]])
; CHECK-NEXT:    [[DIFF:%.*]] = add nuw nsw i256 [[TMP0]], [[K]]
