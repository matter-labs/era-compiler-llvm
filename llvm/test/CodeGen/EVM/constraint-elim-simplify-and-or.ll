; CHECK-NEXT:    [[C2:%.*]] = icmp ule i256 [[B]], [[C]]
; CHECK-NEXT:    [[C3:%.*]] = icmp ule i256 [[C]], [[F]]
; CHECK-NEXT:    [[AND1:%.*]] = and i1 [[C1]], [[C2]]
; CHECK-NEXT:    [[AND2:%.*]] = and i1 [[AND1]], [[C3]]
; CHECK-NEXT:    br i1 [[AND2]], label %[[THEN:.*]], label %[[EXIT:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[EQ:%.*]] = icmp eq i256 [[A]], [[B]]
; CHECK-NEXT:    [[ULT:%.*]] = icmp ult i256 [[A]], [[F]]
; CHECK-NEXT:    ret i1 true
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret i1 false
;
entry:
  %c1 = icmp ule i256 %a, %b
  %c2 = icmp ule i256 %b, %c
  %c3 = icmp ule i256 %c, %f
