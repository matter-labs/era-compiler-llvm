target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
target triple = "evm-unknown-unknown"

define i1 @test_or_disjoint_set_operand_i256(i256 %x) {
; CHECK-LABEL: define i1 @test_or_disjoint_set_operand_i256(
; CHECK-SAME: i256 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[CMP1:%.*]] = icmp ule i256 [[X]], 0
; CHECK-NEXT:    [[CMP2:%.*]] = icmp ne i256 [[X]], 0
; CHECK-NEXT:    ret i1 true
;
entry:
  %cmp1 = icmp ule i256 %x, 0
  %cmp2 = icmp ne i256 %x, 0
  %or = or disjoint i1 %cmp2, %cmp1
  ret i1 %or
}

define i1 @test_or_disjoint_implied_by_dominating_constraints(i256 %a, i256 %b, i256 %c, i256 %f) {
