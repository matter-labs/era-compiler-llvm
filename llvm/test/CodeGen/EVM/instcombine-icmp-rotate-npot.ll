; Verify that InstCombine does not fold `fshl.i24(x, x, 1) == fshl.i24(y, y, 2)`
; into `fshl.i24(x, x, -1) == y` (i.e. `rotl24(x, 15) == y`) when 256-bit
; 24-bit rotates are narrowed to i24 through a switch.
define private i256 @helper(i256 %x, i256 %y, i256 %a, i256 %b, i256 %alt) {
entry:
  %a_hi = and i256 %a, 65536
  %da = or i256 %a_hi, 1
  %b_hi = and i256 %b, 65536
  %db = or i256 %b_hi, 1
  %x_mask = and i256 %x, 16777215
  %y_mask = and i256 %y, 16777215
  %x1 = udiv i256 %x_mask, %da
  %x2 = udiv i256 %x_mask, %db
  %y1 = udiv i256 %y_mask, %da
  %y2 = udiv i256 %y_mask, %db
  %x_shl = shl i256 %x1, 1
  %x_shr = lshr i256 %x2, 23
  %x_or = or i256 %x_shl, %x_shr
  %rx = and i256 %x_or, 16777215
  %y_shl = shl i256 %y1, 2
  %y_shr = lshr i256 %y2, 22
  %y_or = or i256 %y_shl, %y_shr
  %ry = and i256 %y_or, 16777215
  %diff = xor i256 %rx, %ry
  switch i256 %diff, label %sw.default [
  i256 0, label %sw.eq
  i256 1, label %sw.one
  ]

sw.eq:
  ret i256 1

sw.one:
  ret i256 %alt

sw.default:
  ret i256 0
}

