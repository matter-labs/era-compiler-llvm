define i256 @fshr_rotate_eq_zero_or_eq_0(i256 %x, i256 %y, i256 %a, i256 %b, i256 %c) nounwind {
; CHECK-LABEL: fshr_rotate_eq_zero_or_eq_0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    JUMPDEST
; CHECK-NEXT:    SWAP4
; CHECK-NEXT:    POP
; CHECK-NEXT:    POP
; CHECK-NEXT:    POP
; CHECK-NEXT:    POP
; CHECK-NEXT:    ISZERO
; CHECK-NEXT:    SWAP1
; CHECK-NEXT:    JUMP
  %rot = call i256 @llvm.fshl.i256(i256 %a, i256 %a, i256 %b)
  %rot_or = or i256 %rot, %c
  %cmp1 = icmp eq i256 %rot_or, 0
  %u = select i1 %cmp1, i256 2, i256 1
  %a_or = or i256 %c, %a
  %cmp2 = icmp eq i256 %a_or, 0
  %v = select i1 %cmp2, i256 2, i256 1
  %xor = xor i256 %u, %v
  %mask = or i256 %b, 2
  %z_amt = and i256 %xor, %mask
  %or = or i256 %y, %x
  %f = call i256 @llvm.fshr.i256(i256 %or, i256 %x, i256 %z_amt)
  %cmp = icmp eq i256 %f, 0
  %ext = zext i1 %cmp to i256
  ret i256 %ext
}
