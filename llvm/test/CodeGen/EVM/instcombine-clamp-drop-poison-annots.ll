; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -S -passes=instcombine < %s | FileCheck %s

target datalayout = "E-p:256:256-i256:256:256-S256-a:256:256"
target triple = "evm-unknown-unknown"

declare i256 @llvm.umin.i256(i256, i256)
declare i256 @llvm.umax.i256(i256, i256)

; Regression test for llvm/llvm-project#231537:
; Canonicalizing a clamp select `(x > 42) ? umin(x, 1000) : 42` to
; `umax(umin(x, 1000), 42)` must drop poison-generating range() attributes on
; the inner umin; otherwise InstCombine assumes umin >= 43 and folds away the
; umax, miscompiling inputs <= 42.
define i256 @clamp_umax_of_umin_range_i256(i256 %x) {
; CHECK-LABEL: define i256 @clamp_umax_of_umin_range_i256(
; CHECK-SAME: i256 [[X:%.*]]) {
; CHECK-NEXT:    [[UMIN:%.*]] = call i256 @llvm.umin.i256(i256 [[X]], i256 1000)
; CHECK-NEXT:    [[RES:%.*]] = call i256 @llvm.umax.i256(i256 [[UMIN]], i256 42)
; CHECK-NEXT:    ret i256 [[RES]]
;
  %umin = call range(i256 43, 1001) i256 @llvm.umin.i256(i256 %x, i256 1000)
  %cmp = icmp ugt i256 %x, 42
  %res = select i1 %cmp, i256 %umin, i256 42
  ret i256 %res
}

define i256 @clamp_umin_of_umax_range_i256(i256 %x) {
; CHECK-LABEL: define i256 @clamp_umin_of_umax_range_i256(
; CHECK-SAME: i256 [[X:%.*]]) {
; CHECK-NEXT:    [[UMAX:%.*]] = call i256 @llvm.umax.i256(i256 [[X]], i256 42)
; CHECK-NEXT:    [[RES:%.*]] = call i256 @llvm.umin.i256(i256 [[UMAX]], i256 1000)
; CHECK-NEXT:    ret i256 [[RES]]
;
  %umax = call range(i256 42, 1000) i256 @llvm.umax.i256(i256 %x, i256 42)
  %cmp = icmp ugt i256 %x, 999
  %res = select i1 %cmp, i256 1000, i256 %umax
  ret i256 %res
}
