; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 5
; RUN: opt -passes='default<O3>' -S < %s | FileCheck %s

target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
target triple = "eravm"

; Verify that ScalarEvolution does not pass ControlsOnlyExit=true to sub-conditions
; of a non-trivial logical OR/AND loop exit condition, which previously caused
; IndVarSimplify::eliminateTrunc to drop the low-8-bit mask (trunc i256 %iv to i8)
; on the induction variable.
define i256 @scev_binop_controls_only_exit(i256 %x, i256 %y, i256 %z, i256 %a, i256 %b, i256 %n) {
; CHECK-LABEL: define i256 @scev_binop_controls_only_exit(
; CHECK-SAME: i256 [[X:%.*]], i256 [[Y:%.*]], i256 [[Z:%.*]], i256 [[A:%.*]], i256 [[B:%.*]], i256 [[N:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[XY:%.*]] = icmp ult i256 [[X]], [[Y]]
; CHECK-NEXT:    [[YZ:%.*]] = icmp ult i256 [[Y]], [[Z]]
; CHECK-NEXT:    [[PRE:%.*]] = and i1 [[XY]], [[YZ]]
; CHECK-NEXT:    br i1 [[PRE]], label %[[PH:.*]], label %[[COMMON_RET:.*]]
; CHECK:       [[PH]]:
; CHECK-NEXT:    [[TMP0:%.*]] = trunc i256 [[A]] to i16
; CHECK-NEXT:    [[DIV16_LHS_TRUNC:%.*]] = and i16 [[TMP0]], 32767
; CHECK-NEXT:    [[TMP1:%.*]] = trunc i256 [[B]] to i16
; CHECK-NEXT:    [[TMP2:%.*]] = and i16 [[TMP1]], 255
; CHECK-NEXT:    [[DIV16_RHS_TRUNC:%.*]] = or disjoint i16 [[TMP2]], 256
; CHECK-NEXT:    [[DIV161:%.*]] = udiv i16 [[DIV16_LHS_TRUNC]], [[DIV16_RHS_TRUNC]]
; CHECK-NEXT:    [[DIV8_LHS_TRUNC:%.*]] = trunc nuw nsw i16 [[DIV161]] to i8
; CHECK-NEXT:    [[TMP3:%.*]] = trunc i256 [[B]] to i8
; CHECK-NEXT:    [[TMP4:%.*]] = and i8 [[TMP3]], 14
; CHECK-NEXT:    [[DIV8_RHS_TRUNC:%.*]] = or disjoint i8 [[TMP4]], 1
; CHECK-NEXT:    [[DIV82:%.*]] = udiv i8 [[DIV8_LHS_TRUNC]], [[DIV8_RHS_TRUNC]]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i256 [ 0, %[[PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[ACC:%.*]] = phi i256 [ 0, %[[PH]] ], [ [[ACC_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[TMP5:%.*]] = trunc i256 [[IV]] to i16
; CHECK-NEXT:    [[U_LHS_TRUNC:%.*]] = and i16 [[TMP5]], 255
; CHECK-NEXT:    [[TMP6:%.*]] = trunc i256 [[IV]] to i8
; CHECK-NEXT:    [[EQ:%.*]] = icmp eq i8 [[DIV82]], [[TMP6]]
; CHECK-NEXT:    [[BONUS:%.*]] = zext i1 [[EQ]] to i256
; CHECK-NEXT:    [[ACC_NEXT]] = add i256 [[ACC]], [[BONUS]]
; CHECK-NEXT:    [[C1:%.*]] = icmp ult i16 [[U_LHS_TRUNC]], [[DIV161]]
; CHECK-NEXT:    [[C2:%.*]] = icmp ult i256 [[IV]], [[N]]
; CHECK-NEXT:    [[COND:%.*]] = select i1 [[C1]], i1 true, i1 [[C2]]
; CHECK-NEXT:    [[IV_NEXT]] = add i256 [[IV]], 1
; CHECK-NEXT:    br i1 [[COND]], label %[[LOOP]], label %[[COMMON_RET]]
; CHECK:       [[COMMON_RET]]:
; CHECK-NEXT:    [[COMMON_RET_OP:%.*]] = phi i256 [ 0, %[[ENTRY]] ], [ [[ACC_NEXT]], %[[LOOP]] ]
; CHECK-NEXT:    ret i256 [[COMMON_RET_OP]]
;
entry:
  %xy = icmp ult i256 %x, %y
  %yz = icmp ult i256 %y, %z
  %pre = and i1 %xy, %yz
  br i1 %pre, label %ph, label %ret0

ph:
  %xz = icmp uge i256 %x, %z
  %a16 = and i256 %a, 32767
  %b16 = and i256 %b, 255
  %b16.nz = or i256 %b16, 256
  %div16 = udiv i256 %a16, %b16.nz
  %b8 = and i256 %b, 15
  %b8.nz = or i256 %b8, 1
  %div8 = udiv i256 %div16, %b8.nz
  br label %loop

loop:
  %iv = phi i256 [ 0, %ph ], [ %iv.next, %loop ]
  %acc = phi i256 [ 0, %ph ], [ %acc.next, %loop ]
  %iv.mask = and i256 %iv, 255
  %val = select i1 %xz, i256 %iv, i256 0
  %one16_mask = and i256 %val, 256
  %one16 = or i256 %one16_mask, 1
  %u = udiv i256 %iv.mask, %one16
  %eq = icmp eq i256 %iv.mask, %div8
  %bonus = zext i1 %eq to i256
  %acc.next = add i256 %acc, %bonus
  %c1 = icmp ult i256 %u, %div16
  %c2 = icmp ult i256 %iv, %n
  %cond = select i1 %c1, i1 true, i1 %c2
  %iv.next = add i256 %iv, 1
  br i1 %cond, label %loop, label %exit

exit:
  ret i256 %acc.next

ret0:
  ret i256 0
}
