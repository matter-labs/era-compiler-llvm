# RUN: llc -x mir -run-pass=if-converter -verify-machineinstrs < %s | FileCheck %s

# Check that a predicated use of $r2 doesn't end its live range. The value is
# still read by the other arm of the diamond, so the predicated redefinition of
# $r2 in between must implicitly use it.

--- |
  target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
  target triple = "eravm"
  define i256 @diamond() optsize { ret i256 0 }
...
---
# CHECK-LABEL: name: diamond
# CHECK:      $r1 = ADDirr_s i256 7, $r2, i256 2, implicit $flags{{$}}
# CHECK-NEXT: $r2 = ADDirr_s i256 5, killed $r3, i256 2, implicit $flags, implicit killed $r2{{$}}
# CHECK-NEXT: $r1 = ADDrrr_s killed $r1, $r2, i256 2
# CHECK-NEXT: $r1 = ADDirr_s i256 9, killed $r2, i256 4
name:            diamond
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2, $r3
    dead $r0 = SUBrrr_v killed $r1, $r0, i256 0, implicit-def $flags
    JCl %bb.2, i256 2, implicit killed $flags

  bb.1:
    liveins: $r2
    $r1 = ADDirr_s i256 9, killed $r2, i256 0
    $r1 = ADDrrr_s killed $r1, $r1, i256 0
    $r1 = ADDrrr_s killed $r1, $r1, i256 0
    $r1 = ADDrrr_s killed $r1, $r1, i256 0
    RET i256 0, implicit $r1

  bb.2:
    liveins: $r2, $r3
    $r1 = ADDirr_s i256 7, killed $r2, i256 0
    $r2 = ADDirr_s i256 5, killed $r3, i256 0
    $r1 = ADDrrr_s killed $r1, killed $r2, i256 0
    RET i256 0, implicit $r1
...
