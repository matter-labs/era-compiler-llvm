  %c2 = icmp ugt i256 %x_xor, %m_xor
  br i1 %c2, label %calc, label %bail

bail:
  ret i256 0

calc:
  %s = shl i256 %x, 63
  %o = or i256 %s, 1
  %sum = add i256 %o, %x

  %sum64 = and i256 %sum, 18446744073709551615
  %u = udiv i256 %sum64, %one64

  %o64 = and i256 %o, 18446744073709551615
  %u2 = udiv i256 %o64, %one64

  %cmp = icmp ule i256 %u, 1
  %res = zext i1 %cmp to i256
  %u2_hi = shl i256 %u2, 64
  %out = or i256 %res, %u2_hi
  ret i256 %out
}

