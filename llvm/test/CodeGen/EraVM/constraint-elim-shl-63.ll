  %q = udiv i256 %num, %den
  %x = lshr i256 %q, 1

  %k33 = and i256 %k, 4294967296
  %one64 = or i256 %k33, 1

  %m64_in = and i256 %m, 18446744073709551615
  %m_div = udiv i256 %m64_in, %one64

  %m_xor = xor i256 %m_div, 9223372036854775808
  %c1 = icmp ugt i256 %m_xor, 9223372036854775806
  br i1 %c1, label %bb2, label %bail

bb2:
