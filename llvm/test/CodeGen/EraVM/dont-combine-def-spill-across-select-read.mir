# RUN: llc -x mir -run-pass=eravm-combine-addressing-mode -verify-machineinstrs -compile-twice=false < %s | FileCheck %s

# Combining a def with its spill makes the def write the stack slot, so the
# write moves up to the def. A select that reads the slot in between must
# prevent it, whichever input reads the stack. So must an instruction that
# another combine of the same run rewrites to read the slot.

--- |

  target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
  target triple = "eravm"

  define void @dont_combine_select_in1_read() { ret void }
  define void @dont_combine_select_in0_read() { ret void }
  define void @combine_select_other_slot() { ret void }
  define void @dont_combine_pending_select_read() { ret void }
  define void @dont_combine_pending_read() { ret void }
  define void @combine_pending_read_other_slot() { ret void }

...
---
# The select reads the spill slot via in1.
# CHECK-LABEL: name: dont_combine_select_in1_read
# CHECK:      $r4 = ADDrrr_s $r1, $r2, 0
# CHECK-NEXT: dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
# CHECK-NEXT: $r5 = SELrsr $r3, $sp, 32, -1, i256 2, implicit $flags
# CHECK-NEXT: ADDrrs_s killed $r4, $r0, $sp, 32, -1, 0
name:            dont_combine_select_in1_read
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    $r4 = ADDrrr_s $r1, $r2, 0
    dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
    $r5 = SELrsr $r3, $sp, 32, -1, i256 2, implicit $flags
    ADDrrs_s killed $r4, $r0, $sp, 32, -1, 0
    $r1 = ADDrrr_s killed $r5, $r0, 0
    RET 0, implicit $r1

...
---
# The select reads the spill slot via in0.
# CHECK-LABEL: name: dont_combine_select_in0_read
# CHECK:      $r4 = ADDrrr_s $r1, $r2, 0
# CHECK-NEXT: dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
# CHECK-NEXT: $r3 = SELsrr $sp, 32, -1, killed $r3, i256 2, implicit $flags
# CHECK-NEXT: ADDrrs_s killed $r4, $r0, $sp, 32, -1, 0
name:            dont_combine_select_in0_read
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    $r4 = ADDrrr_s $r1, $r2, 0
    dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
    $r3 = SELsrr $sp, 32, -1, killed $r3, i256 2, implicit $flags
    ADDrrs_s killed $r4, $r0, $sp, 32, -1, 0
    $r1 = ADDrrr_s killed $r3, $r0, 0
    RET 0, implicit $r1

...
---
# The select reads another slot, so the def and the spill are combined.
# CHECK-LABEL: name: combine_select_other_slot
# CHECK:      ADDrrs_s $r1, $r2, $sp, 32, -1, 0
# CHECK-NEXT: dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
# CHECK-NEXT: $r5 = SELrsr $r3, $sp, 32, -2, i256 2, implicit $flags
# CHECK-NEXT: $r1 = ADDrrr_s killed $r5, $r0, 0
name:            combine_select_other_slot
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    $r4 = ADDrrr_s $r1, $r2, 0
    dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
    $r5 = SELrsr $r3, $sp, 32, -2, i256 2, implicit $flags
    ADDrrs_s killed $r4, $r0, $sp, 32, -1, 0
    $r1 = ADDrrr_s killed $r5, $r0, 0
    RET 0, implicit $r1

...
---
# Both values are spilled to the same slot. The first combine makes the select
# read the slot, where the first value is at that point. The second combine
# would write the second value to the slot before the select.
# CHECK-LABEL: name: dont_combine_pending_select_read
# CHECK:      ADDrrs_s $r1, $r2, $sp, 32, -1, 0
# CHECK-NEXT: $r5 = ADDrrr_s $r1, $r3, 0
# CHECK-NEXT: dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
# CHECK-NEXT: $r3 = SELsrr $sp, 32, -1, killed $r3, i256 2, implicit $flags
# CHECK-NEXT: ADDrrs_s killed $r5, $r0, $sp, 32, -1, 0
name:            dont_combine_pending_select_read
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    $r4 = ADDrrr_s $r1, $r2, 0
    ADDrrs_s $r4, $r0, $sp, 32, -1, 0
    $r5 = ADDrrr_s $r1, $r3, 0
    dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
    $r3 = SELrrr killed $r4, killed $r3, i256 2, implicit $flags
    ADDrrs_s killed $r5, $r0, $sp, 32, -1, 0
    $r1 = ADDrrr_s killed $r3, $r0, 0
    RET 0, implicit $r1

...
---
# The same with a use other than a select.
# CHECK-LABEL: name: dont_combine_pending_read
# CHECK:      ADDrrs_s $r1, $r2, $sp, 32, -1, 0
# CHECK-NEXT: $r5 = ADDrrr_s $r1, $r3, 0
# CHECK-NEXT: $r3 = ADDsrr_s $sp, 32, -1, killed $r3, 0
# CHECK-NEXT: ADDrrs_s killed $r5, $r0, $sp, 32, -1, 0
name:            dont_combine_pending_read
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    $r4 = ADDrrr_s $r1, $r2, 0
    ADDrrs_s $r4, $r0, $sp, 32, -1, 0
    $r5 = ADDrrr_s $r1, $r3, 0
    $r3 = ADDrrr_s killed $r4, killed $r3, 0
    ADDrrs_s killed $r5, $r0, $sp, 32, -1, 0
    $r1 = ADDrrr_s killed $r3, $r0, 0
    RET 0, implicit $r1

...
---
# The values are spilled to different slots, so both are combined.
# CHECK-LABEL: name: combine_pending_read_other_slot
# CHECK:      ADDrrs_s $r1, $r2, $sp, 32, -2, 0
# CHECK-NEXT: ADDrrs_s $r1, $r3, $sp, 32, -1, 0
# CHECK-NEXT: dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
# CHECK-NEXT: $r3 = SELsrr $sp, 32, -2, killed $r3, i256 2, implicit $flags
# CHECK-NEXT: $r1 = ADDrrr_s killed $r3, $r0, 0
name:            combine_pending_read_other_slot
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3

    $r4 = ADDrrr_s $r1, $r2, 0
    ADDrrs_s $r4, $r0, $sp, 32, -2, 0
    $r5 = ADDrrr_s $r1, $r3, 0
    dead $r0 = SUBrrr_v $r1, $r2, i256 0, implicit-def $flags
    $r3 = SELrrr killed $r4, killed $r3, i256 2, implicit $flags
    ADDrrs_s killed $r5, $r0, $sp, 32, -1, 0
    $r1 = ADDrrr_s killed $r3, $r0, 0
    RET 0, implicit $r1

...
