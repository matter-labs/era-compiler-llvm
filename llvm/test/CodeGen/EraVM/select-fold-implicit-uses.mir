# RUN: llc -x mir -run-pass=eravm-opt-select-postra -verify-machineinstrs < %s | FileCheck %s

# Check that the instruction a conditional move is folded into gets the
# implicit uses of the conditional move.

--- |
  target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
  target triple = "eravm"
  define void @fold_carries_implicit_uses() { ret void }
  define void @fold_adds_flags_use() { ret void }
  define void @fold_mul_carries_implicit_uses() { ret void }
...
---
# CHECK-LABEL: name: fold_carries_implicit_uses
# CHECK:     $r3 = ADDrrr_s $r1, $r1, 2, implicit $flags, implicit $r3{{$}}
# CHECK-NOT: ADDrrr_s
name: fold_carries_implicit_uses
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r3, $flags
    $r2 = ADDrrr_s $r1, $r1, i256 0
    $r3 = ADDrrr_s killed $r2, $r0, i256 2, implicit killed $flags, implicit $r3
    RET 0, implicit $r3
...
---
# The conditional move has no implicit use of its output, only $flags.
# CHECK-LABEL: name: fold_adds_flags_use
# CHECK: $r1 = ADDirr_s i256 1024, $r1, 2, implicit $flags{{$}}
name: fold_adds_flags_use
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $flags
    $r2 = ADDirr_s i256 1024, $r1, i256 0
    $r1 = ADDrrr_s killed $r2, $r0, i256 2, implicit $flags
    RET 0, implicit $r1
...
---
# CHECK-LABEL: name: fold_mul_carries_implicit_uses
# CHECK: $r3, dead $r4 = MULrrrr_s $r1, $r2, 2, implicit $flags, implicit $r3{{$}}
name: fold_mul_carries_implicit_uses
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $r3, $flags
    $r5, dead $r4 = MULrrrr_s $r1, $r2, i256 0
    $r3 = ADDrrr_s killed $r5, $r0, i256 2, implicit $flags, implicit $r3
    RET 0, implicit $r3
...
