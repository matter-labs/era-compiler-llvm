# RUN: llc -x mir -run-pass=eravm-expand-select -verify-machineinstrs < %s | FileCheck %s

# Check that a predicated mov from select expansion implicitly uses its output
# register, as the old value survives when the predicate is false.

--- |
  target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
  target triple = "eravm"
  define void @sel_distinct_out() { ret void }
  define void @sel_out_is_in0() { ret void }
  define void @sel_stack_out() { ret void }
...
---
# CHECK-LABEL: name: sel_distinct_out
# CHECK:      $r3 = ADDrrr_s $r2, $r0, 0
# CHECK-NEXT: $r3 = ADDrrr_s $r1, $r0, 2, implicit $flags, implicit $r3
name: sel_distinct_out
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $flags
    $r3 = SELrrr $r1, $r2, i256 2, implicit $flags
    RET 0, implicit $r3
...
---
# out == in0, lowered to a single mov with the inverse condition.
# CHECK-LABEL: name: sel_out_is_in0
# CHECK-NOT:  ADDrrr_s $r1, $r0, 0
# CHECK:      $r1 = ADDrrr_s $r2, $r0, 4, implicit $flags, implicit $r1
name: sel_out_is_in0
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $flags
    $r1 = SELrrr $r1, $r2, i256 2, implicit $flags, implicit $r1(tied-def 0)
    RET 0, implicit $r1
...
---
# Stack output, no implicit register use is added.
# CHECK-LABEL: name: sel_stack_out
# CHECK: ADDirs_s i256 42, $r0, i256 0, $r2, 0, 3, implicit $flags{{$}}
name: sel_stack_out
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2, $flags
    SELsis i256 0, $r1, 0, i256 42, i256 0, $r2, 0, i256 6, implicit $flags
    RET 0
...
