target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
target triple = "eravm-unknown-unknown"

declare i256 @llvm.umax.i256(i256, i256)

; Regression test for llvm/llvm-project#233527:
; Accumulator recursion elimination must drop poison-generating attributes
; (such as range()) from the accumulator instruction before rewriting its
; operands and cloning it into return blocks.
define i256 @test_drop_poison_attrs_i256(i256 %n, i256 %r) {
