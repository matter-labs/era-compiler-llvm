; TRE-SAME: i256 [[N:%.*]], i256 [[R:%.*]]) {
; TRE-NEXT:  [[ENTRY:.*]]:
; TRE-NEXT:    br label %[[TAILRECURSE:.*]]
; TRE:       [[TAILRECURSE]]:
; TRE-NEXT:    [[ACCUMULATOR_TR:%.*]] = phi i256 [ 0, %[[ENTRY]] ], [ [[M:%.*]], %[[RECURSE:.*]] ]
; TRE-NEXT:    [[N_TR:%.*]] = phi i256 [ [[N]], %[[ENTRY]] ], [ [[SUB:%.*]], %[[RECURSE]] ]
; TRE-NEXT:    [[CMP:%.*]] = icmp eq i256 [[N_TR]], 0
; TRE-NEXT:    br i1 [[CMP]], label %[[RETURN:.*]], label %[[RECURSE]]
; TRE:       [[RECURSE]]:
; TRE-NEXT:    [[SUB]] = sub i256 [[N_TR]], 1
; TRE-NEXT:    [[M]] = tail call i256 @llvm.umax.i256(i256 [[ACCUMULATOR_TR]], i256 1)
; TRE-NEXT:    br label %[[TAILRECURSE]]
; TRE:       [[RETURN]]:
; TRE-NEXT:    [[ACCUMULATOR_RET_TR:%.*]] = tail call i256 @llvm.umax.i256(i256 [[ACCUMULATOR_TR]], i256 [[R]])
; TRE-NEXT:    ret i256 [[ACCUMULATOR_RET_TR]]
;
; O3-LABEL: define i256 @test_drop_poison_attrs_i256(
; O3-SAME: i256 [[N:%.*]], i256 [[R:%.*]]) local_unnamed_addr #[[ATTR1:[0-9]+]] {
; O3-NEXT:  [[ENTRY:.*:]]
; O3-NEXT:    [[CMP1:%.*]] = icmp ne i256 [[N]], 0
; O3-NEXT:    [[ACCUMULATOR_TR_LCSSA:%.*]] = zext i1 [[CMP1]] to i256
; O3-NEXT:    [[ACCUMULATOR_RET_TR:%.*]] = tail call i256 @llvm.umax.i256(i256 [[ACCUMULATOR_TR_LCSSA]], i256 [[R]])
; O3-NEXT:    ret i256 [[ACCUMULATOR_RET_TR]]
;
entry:
