# RUN: llc -x mir -run-pass=if-converter -verify-machineinstrs < %s | FileCheck %s

# Check that we do not if-convert a block with an instruction that writes
# $flags, even if it's not a `!` instruction.

--- |
  target datalayout = "E-p:256:256-i256:256:256-S32-a:256:256"
  target triple = "eravm"
  define void @triangle_flags_def() { ret void }
...
---
# CHECK-LABEL: name: triangle_flags_def
# CHECK:      bb.0:
# CHECK:        JCl %bb.2, i256 3
# CHECK:      bb.1:
# CHECK:        $r2 = ADDrrr_s $r2, $r2, i256 0, implicit-def $flags
# CHECK-NEXT:   $r3 = ADDrrr_s $r3, $r3, i256 0
name: triangle_flags_def
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $r1, $r2, $r3
    dead $r0 = SUBrrr_v $r1, $r0, i256 0, implicit-def $flags
    JCl %bb.2, i256 3, implicit $flags

  bb.1:
    successors: %bb.2
    liveins: $r2, $r3
    $r2 = ADDrrr_s $r2, $r2, i256 0, implicit-def $flags
    $r3 = ADDrrr_s $r3, $r3, i256 0

  bb.2:
    liveins: $r2, $r3
    RET 0, implicit $r2, implicit $r3
...
