# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=thumbv7-apple-ios -run-pass=if-converter -verify-machineinstrs %s -o - | FileCheck %s

# Check that a predicated use doesn't end the live range of $r2, which is still
# read if the predicate is false, so the predicated redefinition of $r2 gets an
# implicit use of it.

---
name:            simple
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: simple
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $r0, $r1, $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   t2CMPri killed $r0, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
  ; CHECK-NEXT:   $r0 = t2ADDri $r2, 7, 1 /* CC::ne */, $cpsr, $noreg
  ; CHECK-NEXT:   $r2 = t2ADDri killed $r1, 5, 1 /* CC::ne */, $cpsr, $noreg, implicit killed $r2
  ; CHECK-NEXT:   $r0 = t2ADDrr killed $r0, $r2, 1 /* CC::ne */, $cpsr, $noreg, implicit killed $r0
  ; CHECK-NEXT:   tBX_RET 1 /* CC::ne */, killed $cpsr, implicit killed $r0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $r2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r0 = t2ADDri killed $r2, 9, 14 /* CC::al */, $noreg, $noreg
  ; CHECK-NEXT:   $r0 = t2ADDrr killed $r0, $r0, 14 /* CC::al */, $noreg, $noreg
  ; CHECK-NEXT:   $r0 = t2ADDrr killed $r0, $r0, 14 /* CC::al */, $noreg, $noreg
  ; CHECK-NEXT:   $r0 = t2ADDrr killed $r0, $r0, 14 /* CC::al */, $noreg, $noreg
  ; CHECK-NEXT:   tBX_RET 14 /* CC::al */, $noreg, implicit $r0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1, $r2

    t2CMPri killed $r0, 0, 14 /* CC::al */, $noreg, implicit-def $cpsr
    t2Bcc %bb.2, 0 /* CC::eq */, killed $cpsr

  bb.1:
    liveins: $r1, $r2
    $r0 = t2ADDri killed $r2, 7, 14 /* CC::al */, $noreg, $noreg
    $r2 = t2ADDri killed $r1, 5, 14 /* CC::al */, $noreg, $noreg
    $r0 = t2ADDrr killed $r0, killed $r2, 14 /* CC::al */, $noreg, $noreg
    tBX_RET 14 /* CC::al */, $noreg, implicit $r0

  bb.2:
    liveins: $r2
    $r0 = t2ADDri killed $r2, 9, 14 /* CC::al */, $noreg, $noreg
    $r0 = t2ADDrr killed $r0, $r0, 14 /* CC::al */, $noreg, $noreg
    $r0 = t2ADDrr killed $r0, $r0, 14 /* CC::al */, $noreg, $noreg
    $r0 = t2ADDrr killed $r0, $r0, 14 /* CC::al */, $noreg, $noreg
    tBX_RET 14 /* CC::al */, $noreg, implicit $r0
...
